# ── Database (SQL Server) ────────────────────────────────────────────────────
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=1433

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── SSN encryption (AES-256-GCM, required) ───────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SSN_ENCRYPTION_KEY=

# ── Dropbox Sign ─────────────────────────────────────────────────────────────
DROPBOX_SIGN_API_KEY=
# Membership application template (main signing flow)
DS_TEMPLATE_ID=
# References signature template
DROPBOX_SIGN_REFERENCES_TEMPLATE_ID=

# Set to "true" only in dev/staging to use Dropbox Sign sandbox.
# Leave unset (or "false") in production — real signatures required.
DS_TEST_MODE=

# ── Email notifications (optional) ───────────────────────────────────────────
# All EMAIL_* vars are optional. If EMAIL_HOST is unset, emails are silently skipped.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
